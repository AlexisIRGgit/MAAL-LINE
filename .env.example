# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth (for authentication)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Conekta (Mexico payments - optional)
CONEKTA_API_KEY=""
CONEKTA_PUBLIC_KEY=""

# Resend (emails)
RESEND_API_KEY=""

# Cloudinary (images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Maps (address search + map in /cuenta/direcciones). Without the key the
# wizard falls back to OpenStreetMap/CARTO. Restrict the key to your domains in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Map ID from Google Cloud > Map Management (vector map); needed for the dark scheme and advanced markers
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# ntfy push notifications to the store owner (paid orders). Full topic URL; use a long,
# random topic name because anyone who knows it can read the messages.
NTFY_TOPIC_URL="https://ntfy.sh/maal-pedidos-<random>"
# Optional: access token for a protected topic or self-hosted ntfy
NTFY_TOKEN=""

# Transactional email (order shipped, welcome, owner alerts) through Resend.
# EMAIL_FROM must be on a domain verified in Resend (RESEND_API_KEY is above).
EMAIL_FROM="MAAL LINE <contacto@maalline.com>"
